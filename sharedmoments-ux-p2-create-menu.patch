diff --git a/app/templates/layouts/couple-create-sheet.html b/app/templates/layouts/couple-create-sheet.html
new file mode 100644
index 0000000..67ea135
--- /dev/null
+++ b/app/templates/layouts/couple-create-sheet.html
@@ -0,0 +1,116 @@
+{#
+   Zentrales Erstellen-Menue der Couples-Oberflaeche.
+
+   Wird auf jeder Couples-Seite eingebunden, damit das "+" der Bottom-Nav
+   das Sheet lokal oeffnet, statt erst nach /home zu navigieren.
+
+   couple_create_query steuert, was ein "?create=1" auf dieser Seite oeffnet:
+   'sheet' | 'memory' | 'milestone' | 'none' (Standard, wenn die Seite ihr
+   eigenes create=1 bereits selbst behandelt).
+#}
+<div class="overlay"
+     id="div-overlay-couple-create"
+     data-dialog="#dialog-couple-create"
+     onclick="closeCoupleCreateMenu()"></div>
+
+<dialog class="bottom" id="dialog-couple-create"
+        data-create-query="{{ couple_create_query|default('none') }}">
+   <div class="couple-create-drag-zone"
+        id="couple-create-drag-zone"
+        aria-label="Zum Schliessen nach unten ziehen">
+      <div class="couple-create-drag-handle" aria-hidden="true"></div>
+      <nav>
+         <button class="circle transparent"
+                 aria-label="Menue schliessen"
+                 onclick="closeCoupleCreateMenu()">
+            <i>close</i>
+         </button>
+         <h6 class="max couple-create-title">Was möchtest du hinzufügen?</h6>
+      </nav>
+   </div>
+
+   <div class="space"></div>
+
+   {% if has_list_permission('Create', 'Home') %}
+   <a class="row padding couple-create-item"
+      data-couple-create="memory"
+      href="{{ url_for('pages.memories', create=1) }}">
+      <i>photo_camera</i>
+      <div class="max">
+         <strong>Erinnerung</strong>
+         <div class="small">Foto, Video oder gemeinsamer Moment</div>
+      </div>
+      <i>chevron_right</i>
+   </a>
+   {% endif %}
+
+   <a class="row padding couple-create-item"
+      data-couple-create="heart"
+      href="/heart-moments?create=1">
+      <i>favorite</i>
+      <div class="max">
+         <strong>Herzmoment</strong>
+         <div class="small">Etwas, das sich besonders angefühlt hat</div>
+      </div>
+      <i>chevron_right</i>
+   </a>
+
+   {% if has_list_permission('Create', 'Moments') %}
+   <a class="row padding couple-create-item"
+      data-couple-create="milestone"
+      href="{{ url_for('pages.milestones', create=1) }}">
+      <i>star</i>
+      <div class="max">
+         <strong>Meilenstein</strong>
+         <div class="small">Ein wichtiger Punkt in eurer Geschichte</div>
+      </div>
+      <i>chevron_right</i>
+   </a>
+   {% endif %}
+
+   <a class="row padding couple-create-item"
+      data-couple-create="bucket"
+      href="{{ url_for('pages.bucketlist', create=1) }}">
+      <i>checklist</i>
+      <div class="max">
+         <strong>Bucketlist</strong>
+         <div class="small">Etwas gemeinsam vormerken</div>
+      </div>
+      <i>chevron_right</i>
+   </a>
+
+   <a class="row padding couple-create-item"
+      data-couple-create="plan"
+      href="{{ url_for('pages.plans', create=1) }}">
+      <i>explore</i>
+      <div class="max">
+         <strong>Plan</strong>
+         <div class="small">Etwas, das ihr konkret angehen wollt</div>
+      </div>
+      <i>chevron_right</i>
+   </a>
+
+   <a class="row padding couple-create-item"
+      data-couple-create="chapter"
+      href="{{ url_for('pages.chapters', create=1) }}">
+      <i>auto_stories</i>
+      <div class="max">
+         <strong>Kapitel</strong>
+         <div class="small">Zusammengehörige Erlebnisse miteinander verbinden</div>
+      </div>
+      <i>chevron_right</i>
+   </a>
+
+   <a class="row padding couple-create-item"
+      data-couple-create="place"
+      href="{{ url_for('pages.places', create=1) }}">
+      <i>add_location_alt</i>
+      <div class="max">
+         <strong>Ort</strong>
+         <div class="small">Einen gemeinsamen Ort auf eurer Karte festhalten</div>
+      </div>
+      <i>chevron_right</i>
+   </a>
+</dialog>
+
+<script src="{{ static_versioned('js/couple-create.js') }}"></script>
