+/* Nav-Drawer: aktive Seite sichtbar machen */
+body.couple-app #dialog-nav-drawer a.nav-current {
+   background: color-mix(in srgb, var(--primary-container) 55%, transparent);
+   color: var(--primary);
+   font-weight: 650;
+   border-radius: 999px;
+}
+
+body.couple-app #dialog-nav-drawer .nav-drawer-group {
+   margin: 0.9rem 0 0.2rem;
+   padding: 0 0.75rem;
+   font-size: 0.72rem;
+   font-weight: 650;
+   letter-spacing: 0.06em;
+   text-transform: uppercase;
+   color: color-mix(in srgb, var(--on-surface) 55%, transparent);
+}
+
+/* Fixierter Footer + Back-to-Top kollidieren mobil mit der Bottom-Nav */
+@media (max-width: 900px) {
+   body.couple-app footer.fixed {
+      position: static;
+      padding: 0.4rem 0 0;
+      opacity: 0.55;
+      font-size: 0.72rem;
+   }
+
+   body.couple-app #btn-back-to-top {
+      bottom: calc(6.4rem + env(safe-area-inset-bottom)) !important;
+   }
+}
+
