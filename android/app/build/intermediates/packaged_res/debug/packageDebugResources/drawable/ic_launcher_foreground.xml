<?xml version="1.0" encoding="utf-8"?>
<!-- Zwei Ringe. Auf 108dp gezeichnet, das Motiv bleibt in der inneren
     Sicherheitszone von 66dp, damit keine Launcher-Form es anschneidet.
     Als Pfad statt als Kreis mit Strichbreite, weil die Schnittmenge voll
     deckend sein soll - dort liegt bei runden Formen sonst Kante auf Kante. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- linker Ring -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.78"
        android:fillType="evenOdd"
        android:pathData="M41.5,35 m-19,0 a19,19 0 1,0 38,0 a19,19 0 1,0 -38,0 M41.5,35 m-10.3,0 a10.3,10.3 0 1,0 20.6,0 a10.3,10.3 0 1,0 -20.6,0"/>

    <!-- rechter Ring -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.78"
        android:fillType="evenOdd"
        android:pathData="M66.5,35 m-19,0 a19,19 0 1,0 38,0 a19,19 0 1,0 -38,0 M66.5,35 m-10.3,0 a10.3,10.3 0 1,0 20.6,0 a10.3,10.3 0 1,0 -20.6,0"/>

    <!-- Schnittmenge: gehoert beiden, deshalb voll deckend -->
    <group>
        <clip-path android:pathData="M66.5,35 m-19,0 a19,19 0 1,0 38,0 a19,19 0 1,0 -38,0"/>
        <path
            android:fillColor="#FFFFFF"
            android:fillType="evenOdd"
            android:pathData="M41.5,35 m-19,0 a19,19 0 1,0 38,0 a19,19 0 1,0 -38,0 M41.5,35 m-10.3,0 a10.3,10.3 0 1,0 20.6,0 a10.3,10.3 0 1,0 -20.6,0"/>
    </group>
</vector>
